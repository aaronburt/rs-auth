# rs-auth with Caddy 2. Caddy gets certificates automatically.
# server.trusted_proxies in config.toml must include Caddy's address.

(rs_auth) {
	forward_auth rs-auth:9091 {
		uri /api/verify
		copy_headers Remote-User Remote-Groups Remote-Email Remote-Name
	}
}

# The portal itself.
auth.example.com {
	reverse_proxy rs-auth:9091
}

# A protected app. Repeat for each app.
grafana.example.com {
	import rs_auth
	reverse_proxy grafana:3000
}
